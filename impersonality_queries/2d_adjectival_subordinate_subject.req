% Goal: essere + adjective + che-subordinate with explicit subject.

pattern {
  E [lemma="essere"];
  A [lemma="necessario"|"urgente"|"importante"|"fondamentale"];
  V [upos=VERB, VerbForm=Fin];
  C [lemma="che"];
  S [];

  A -[cop]-> E;
  A -[ccomp]-> V;
  V -[mark]-> C;
  V -[nsubj]-> S;
}

without {
  A -[nsubj]-> X;
}

without {
  S [lemma="che"];
}

without {
  S [PronType=Dem];
}

without {
  V -[expl]-> SI;
  SI [lemma="si"];
}

without {
  V -[expl:impers]-> SI;
}