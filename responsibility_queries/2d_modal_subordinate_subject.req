% 2d_modal_subordinate_subject.req
% Goal: modal + che-subordinate with explicit subject in the subordinate clause.
% Interpretation: agency is expressed, but displaced into the embedded clause.

pattern {
  M [lemma="dovere"|"potere"|"volere", VerbForm=Fin];
  V [upos=VERB];
  C [lemma="che"];
  S [];

  M -[ccomp]-> V;
  V -[mark]-> C;
  V -[nsubj]-> S;
}

without {
  S [lemma="che"];
}

without {
  V -[expl]-> SI;
  SI [lemma="si"];
}